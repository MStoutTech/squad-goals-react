    "@tailwindcss/vite": "^4.2.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "clsx": "^2.1.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-flash": "^0.0.2",
    "express-session": "^1.17.1",
    "moment": "^2.30.1",
    "mongodb": "^7.1.0",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
